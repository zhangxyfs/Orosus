{
  "name": "orosus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "orosus": "node --experimental-strip-types apps/cli/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --filter ./packages/** --filter ./apps/** run typecheck",
    "lint": "oxlint .",
    "check:boundaries": "node --experimental-strip-types scripts/check-boundaries.mts",
    "build": "pnpm -r build",
    "docs:check": "pnpm gen-docs && git diff --exit-code docs/api",
    "gen-docs": "node --experimental-strip-types scripts/gen-api-docs.mts"
  },
  "devDependencies": {
    "@orosus/contracts": "workspace:*",
    "@orosus/core": "workspace:*",
    "@orosus/provider-anthropic": "workspace:*",
    "@orosus/testing": "workspace:*",
    "@orosus/tool-fs": "workspace:*",
    "@orosus/tool-shell": "workspace:*",
    "@types/node": "^22.10.0",
    "oxlint": "^1.0.0",
    "tsdown": "^0.9.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@orosus/provider-glm": "workspace:*",
    "@orosus/provider-kimi": "workspace:*",
    "@orosus/provider-deepseek": "workspace:*",
    "@orosus/provider-openai": "workspace:*"
  }
}
